{
  "name": "check-peer-dependencies",
  "version": "4.3.4",
  "description": "Checks peer dependencies of the current package.  Offers solutions for any that are unmet.",
  "main": "dist/checkPeerDependencies.js",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "release": "release",
    "test": "echo \"Error: no test specified\" && exit 1",
    "prepare": "husky",
    "format": "oxfmt \"src/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\""
  },
  "bin": {
    "check-peer-dependencies": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christopherthielen/check-peer-dependencies.git"
  },
  "keywords": [
    "nodejs",
    "install",
    "peer",
    "dependencies"
  ],
  "author": "Chris Thielen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/christopherthielen/check-peer-dependencies/issues"
  },
  "homepage": "https://github.com/christopherthielen/check-peer-dependencies#readme",
  "dependencies": {
    "resolve": "^1.22.12",
    "semver": "^7.3.4",
    "shelljs": "^0.8.4",
    "yargs": "^16.2.2"
  },
  "devDependencies": {
    "@types/node": "^14.18.63",
    "@types/semver": "^7.8.0",
    "@types/shelljs": "^0.8.17",
    "@types/yargs": "^16.0.11",
    "@uirouter/publish-scripts": "^2.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.68.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.x",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.22.1",
      "onFail": "warn"
    }
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
